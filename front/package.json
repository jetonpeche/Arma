{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/cdk": "^21.2.23",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/material": "~21.0.1",
    "@angular/platform-browser": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@jetonpeche/angular-mat-input": "^1.2.10",
    "@jetonpeche/angular-responsive": "^1.1.0",
    "pixi.js": "^8.21.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.23",
    "baseline-browser-mapping": "^2.9.18",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.26.0": true,
    "esbuild@0.25.12": true,
    "lmdb@3.4.3": true,
    "msgpackr-extract@3.0.3": true
  }
}
